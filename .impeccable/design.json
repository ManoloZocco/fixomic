   "css": ".ds-route{position:relative;display:flex;justify-content:space-between;width:264px;padding:0;margin:8px 30px}.ds-route:before{content:'';position:absolute;left:0;right:0;top:4px;height:3px;border-radius:2px;background:#1e9a52}.ds-st{position:relative;width:11px;height:11px;border-radius:50%;box-sizing:border-box}.ds-st.on{background:#1e9a52;box-shadow:0 0 0 2px #f6f7f9}.ds-st.off{background:#f6f7f9;border:2px solid #1e9a52}"
