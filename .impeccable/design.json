   "html": "<button class=\"ds-switch\" aria-pressed=\"true\"></button>",
   "css": ".ds-switch{width:34px;height:20px;border-radius:10px;border:none;background:#2d6bdf;position:relative}.ds-switch:after{content:'';position:absolute;top:2px;right:2px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 .5px 1px rgba(0,0,0,.18)}.ds-switch[aria-pressed=false]{background:#c9ced5}.ds-switch[aria-pressed=false]:after{left:2px;right:auto}.ds-switch:focus-visible{outline:3px solid rgba(45,107,223,.45);outline-offset:2px}"
